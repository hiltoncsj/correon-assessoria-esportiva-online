---
// Hero 02 — informações e indicadores (CORREON_DESIGN_SYSTEM_MASTER.md §8).
// TODO: substituir TODO o conteúdo abaixo pelos textos e indicadores aprovados
// no briefing institucional. Nenhum número ou texto foi inventado.
const eyebrow = 'SEÇÃO 2';
const title = 'RESULTADOS DA EQUIPE';
const text = 'TODO Texto institucional de apoio à leitura dos indicadores.';
const indicators = [
	{ value: '02', label: 'CIDADES' },
	{ value: '02', label: 'TREINADORES' },
	{ value: '15', label: 'ATLETAS' },
	{ value: '30', label: 'OBJETIVOS' },
];
---

<section class="stats" aria-labelledby="stats-title">
	<div class="stats__inner">
		<div class="stats__intro">
			<p class="stats__eyebrow">{eyebrow}</p>
			<h2 id="stats-title" class="stats__title">{title}</h2>
			<p class="stats__text">{text}</p>
		</div>

		<dl class="stats__list">
			{indicators.map((item) => (
				<div class="stats__item">
					<dt class="stats__label">{item.label}</dt>
					<dd class="stats__value">{item.value}</dd>
				</div>
			))}
		</dl>
	</div>
</section>

<style>
	.stats {
		background: var(--color-background-primary);
		color: var(--color-text-primary);
		padding-block: clamp(3rem, 10vw, 7rem);
	}
	.stats__inner {
		max-width: var(--layout-max-width);
		margin: 0 auto;
		padding: 0 var(--layout-gutter);
		display: grid;
		gap: var(--space-xl);
	}
	.stats__eyebrow {
		margin: 0 0 var(--space-sm);
		font: var(--font-weight-label) var(--text-label) / 1.2 var(--font-label);
		letter-spacing: var(--letter-spacing-label);
		text-transform: uppercase;
		color: var(--color-accent);
	}
	.stats__title {
		margin: 0 0 var(--space-md);
		font: 800 clamp(1.75rem, 4vw, 3rem) / 1.05 var(--font-heading);
		letter-spacing: -0.02em;
		text-transform: uppercase;
		text-wrap: balance;
	}
	.stats__text {
		margin: 0;
		max-width: 32rem;
		font: 400 var(--text-body) / 1.6 var(--font-body);
		color: var(--color-text-secondary);
	}

	.stats__list {
		margin: 0;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		border-top: 1px solid var(--color-border-subtle);
	}
	.stats__item {
		display: flex;
		flex-direction: column-reverse; /* valor em destaque; ordem semântica: rótulo antes do valor */
		justify-content: flex-end;
		align-items: center;
		text-align: center;
		gap: var(--space-xs);
		padding: var(--space-lg) var(--space-md);
		border-bottom: 1px solid var(--color-border-subtle);
	}
	.stats__value {
		margin: 0;
		font: 800 clamp(2.25rem, 7vw, 4rem) / 1 var(--font-display);
		letter-spacing: -0.02em;
		color: var(--color-accent);
		font-variant-numeric: tabular-nums;
	}
	.stats__label {
		font: var(--font-weight-label) var(--text-label) / 1.3 var(--font-label);
		letter-spacing: var(--letter-spacing-label);
		text-transform: uppercase;
		color: var(--color-text-secondary);
	}

	/* Indicadores entram em cascata depois da cortina da seção */
	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			.stats__item {
				animation: stats-in linear both;
				animation-timeline: view();
				animation-range: entry 20% entry 90%;
			}
			.stats__item:nth-child(2) { animation-range: entry 28% entry 95%; }
			.stats__item:nth-child(3) { animation-range: entry 36% entry 100%; }
			.stats__item:nth-child(4) { animation-range: entry 44% entry 100%; }
		}
	}
	@keyframes stats-in {
		from { opacity: 0; transform: translateY(1.5rem); }
	}

	@media (min-width: 48rem) {
		.stats__list {
			grid-template-columns: repeat(4, 1fr);
		}
		.stats__item {
			border-bottom: 0;
			padding-inline: var(--space-lg);
		}
	}
	@media (min-width: 64rem) {
		.stats__inner {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			align-items: end;
			gap: var(--space-xl) calc(var(--space-xl) * 2);
		}
		.stats__list {
			grid-column: 1 / -1;
		}
	}
</style>
