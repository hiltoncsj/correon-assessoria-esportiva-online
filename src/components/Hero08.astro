---
// Hero 08 — perguntas e respostas acessíveis (CORREON_DESIGN_SYSTEM_MASTER.md §8).
// Usa <details>/<summary> nativos: teclado, leitores de tela e funcionamento
// sem JavaScript vêm de graça. TODO: substituir pelas perguntas e respostas
// aprovadas no briefing. Nenhum conteúdo foi inventado.
const eyebrow = 'SEÇÃO 8';
const title = 'PERGUNTAS FREQUENTES';
const text = 'TODO Texto institucional de apoio ao FAQ.';
const faqs = [
	{ q: 'Como funciona a assessoria CorreOn?', a: 'TODO Resposta da pergunta 1.' },
	{ q: 'Preciso ter experiência para começar?', a: 'TODO Resposta da pergunta 2.' },
	{ q: 'Como são elaborados os treinos?', a: 'TODO Resposta da pergunta 3.' },
	{ q: 'Posso treinar em diferentes modalidades?', a: 'TODO Resposta da pergunta 4.' },
	{ q: 'Como faço para entrar na equipe?', a: 'TODO Resposta da pergunta 5.' },
];
---

<section class="faq" id="perguntas" aria-labelledby="faq-title">
	<div class="faq__inner">
		<header class="faq__head">
			<p class="faq__eyebrow">{eyebrow}</p>
			<h2 id="faq-title" class="faq__title">{title}</h2>
			<p class="faq__text">{text}</p>
		</header>

		<div class="faq__list">
			{faqs.map((item) => (
				<details class="faq__item" name="faq">
					<summary class="faq__question">
						<span>{item.q}</span>
						<span class="faq__icon" aria-hidden="true"></span>
					</summary>
					<div class="faq__answer">
						<p>{item.a}</p>
					</div>
				</details>
			))}
		</div>
	</div>
</section>

<style>
	.faq {
		background: var(--color-background-primary);
		color: var(--color-text-primary);
		padding-block: clamp(3rem, 10vw, 7rem);
		scroll-margin-top: calc(var(--header-height) - 140px);
	}
	.faq__inner {
		max-width: var(--layout-max-width);
		margin: 0 auto;
		padding: 0 var(--layout-gutter);
		display: grid;
		gap: var(--space-xl);
	}
	.faq__eyebrow {
		margin: 0 0 var(--space-sm);
		font: var(--font-weight-label) var(--text-label) / 1.2 var(--font-label);
		letter-spacing: var(--letter-spacing-label);
		text-transform: uppercase;
		color: var(--color-accent);
	}
	.faq__title {
		margin: 0 0 var(--space-md);
		font: 800 clamp(1.75rem, 4vw, 3rem) / 1.05 var(--font-heading);
		letter-spacing: -0.02em;
		text-transform: uppercase;
		text-wrap: balance;
	}
	.faq__text {
		margin: 0;
		max-width: 28rem;
		font: 400 var(--text-body) / 1.6 var(--font-body);
		color: var(--color-text-secondary);
	}

	.faq__list {
		border-top: 1px solid var(--color-border-subtle);
	}
	.faq__item {
		border-bottom: 1px solid var(--color-border-subtle);
	}
	.faq__question {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
		min-height: 3.5rem;
		padding: var(--space-md) 0;
		list-style: none;
		cursor: pointer;
		font: 700 1.0625rem / 1.3 var(--font-heading);
		transition: color var(--motion-duration-fast) var(--motion-ease);
	}
	.faq__question::-webkit-details-marker {
		display: none;
	}
	.faq__question:hover {
		color: var(--color-accent);
	}
	.faq__question:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 4px;
		border-radius: var(--radius-sm);
	}

	/* Ícone +/− desenhado em CSS; o estado também é anunciado pelo <details> */
	.faq__icon {
		position: relative;
		flex: none;
		width: 1.25rem;
		height: 1.25rem;
	}
	.faq__icon::before,
	.faq__icon::after {
		content: '';
		position: absolute;
		left: 0;
		top: 50%;
		width: 100%;
		height: 2px;
		background: var(--color-accent);
		transition: transform var(--motion-duration-base) var(--motion-ease);
	}
	.faq__icon::after {
		transform: rotate(90deg);
	}
	.faq__item[open] .faq__icon::after {
		transform: rotate(0);
	}

	.faq__answer {
		padding: 0 0 var(--space-lg);
		max-width: 38rem;
		color: var(--color-text-secondary);
		font: 400 var(--text-body) / 1.6 var(--font-body);
	}
	.faq__answer p {
		margin: 0;
	}
	@media (prefers-reduced-motion: no-preference) {
		.faq__item[open] .faq__answer {
			animation: faq-in var(--motion-duration-base) var(--motion-ease) both;
		}
	}
	@keyframes faq-in {
		from { opacity: 0; transform: translateY(-0.5rem); }
	}

	@media (min-width: 64rem) {
		.faq__inner {
			grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
			column-gap: calc(var(--space-xl) * 2);
			align-items: start;
		}
		.faq__head {
			position: sticky;
			top: calc(var(--header-height) + var(--space-lg));
		}
	}
</style>

<script>
	// Acordeão exclusivo: abrir uma pergunta fecha as outras. O atributo `name`
	// do <details> já faz isso nos navegadores novos; este código cobre os antigos.
	const items = Array.from(document.querySelectorAll<HTMLDetailsElement>('.faq__item'));
	items.forEach((item) => {
		item.addEventListener('toggle', () => {
			if (!item.open) return;
			items.forEach((other) => {
				if (other !== item) other.open = false;
			});
		});
	});
</script>
