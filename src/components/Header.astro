---
import { Image } from 'astro:assets';
import logo from '../assets/logo-correon.png';

// TODO: substituir pelos itens/textos aprovados no briefing institucional CorreON.
// O design system proíbe inventar texto; estes rótulos são apenas marcadores.
const nav = [
	{ label: 'SOBRE', href: '#sobre' },
	{ label: 'PLANOS', href: '#planos' },
	{ label: 'EM MOVIMENTO', href: '#movimento' },
	{ label: 'PERGUNTAS', href: '#perguntas' },
];
// Área restrita (PHP). Em produção fica no mesmo domínio; no computador local roda na porta 8080.
const cta = { label: 'ENTRAR', href: import.meta.env.DEV ? 'http://localhost:8080/entrar' : '/entrar' };
---

<header class="site-header" data-header>
	<a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
	<div class="site-header__inner">
		<a class="site-header__brand" href="/" aria-label="CorreON — página inicial">
			<Image src={logo} alt="CorreON" height={40} loading="eager" />
		</a>

		<nav class="site-header__nav" id="menu-principal" aria-label="Principal" data-nav>
			<ul>
				{nav.map((item) => (
					<li><a href={item.href}>{item.label}</a></li>
				))}
			</ul>
			<a class="btn" href={cta.href}>{cta.label}</a>
		</nav>

		<button
			class="site-header__toggle"
			type="button"
			aria-expanded="false"
			aria-controls="menu-principal"
			data-toggle
		>
			<span class="visually-hidden">Menu</span>
			<span class="site-header__bars" aria-hidden="true"></span>
		</button>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: var(--z-header);
		background: var(--color-overlay);
		backdrop-filter: blur(12px);
		box-shadow: var(--shadow-header);
	}
	.site-header__inner {
		max-width: var(--layout-max-width);
		margin: 0 auto;
		padding: 0 var(--layout-gutter);
		height: var(--header-height);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-lg);
	}
	.site-header__brand {
		display: inline-flex;
		border-radius: var(--radius-sm);
	}
	.site-header__brand :global(img) {
		height: 2.5rem;
		width: auto;
	}

	/* Navegação — mobile primeiro: painel abaixo do header, funciona sem JS (visível) */
	.site-header__nav {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: var(--space-lg);
		position: absolute;
		inset: var(--header-height) 0 auto 0;
		padding: var(--space-lg) var(--layout-gutter);
		background: var(--color-background-primary);
		border-bottom: 1px solid var(--color-border-subtle);
	}
	.site-header__nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
	}
	.site-header__nav li a {
		display: block;
		padding: var(--space-sm) 0;
		font: var(--font-weight-label) var(--text-label) / 1.2 var(--font-label);
		letter-spacing: var(--letter-spacing-label);
		text-transform: uppercase;
		color: var(--color-text-primary);
		text-decoration: none;
		transition: color var(--motion-duration-fast) var(--motion-ease);
	}
	.site-header__nav li a:hover {
		color: var(--color-accent);
	}

	.btn {
		display: inline-flex;
		justify-content: center;
		align-items: center;
		min-height: 2.75rem;
		padding: 0 var(--space-lg);
		border-radius: var(--radius-pill);
		background: var(--color-accent);
		color: var(--color-on-accent);
		font: var(--font-weight-button) var(--text-button) / 1 var(--font-button);
		text-transform: uppercase;
		letter-spacing: var(--letter-spacing-label);
		text-decoration: none;
		transition: background-color var(--motion-duration-fast) var(--motion-ease),
			transform var(--motion-duration-fast) var(--motion-ease);
	}
	.btn:hover {
		background: var(--color-text-primary);
	}

	/* Foco visível consistente */
	a:focus-visible,
	button:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}

	.site-header__toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		background: transparent;
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-sm);
		color: var(--color-text-primary);
		cursor: pointer;
	}
	.site-header__bars,
	.site-header__bars::before,
	.site-header__bars::after {
		display: block;
		width: 1.25rem;
		height: 2px;
		background: currentColor;
		transition: transform var(--motion-duration-base) var(--motion-ease);
	}
	.site-header__bars {
		position: relative;
	}
	.site-header__bars::before,
	.site-header__bars::after {
		content: '';
		position: absolute;
		left: 0;
	}
	.site-header__bars::before {
		top: -6px;
	}
	.site-header__bars::after {
		top: 6px;
	}
	.site-header__toggle[aria-expanded='true'] .site-header__bars {
		background: transparent;
	}
	.site-header__toggle[aria-expanded='true'] .site-header__bars::before {
		transform: translateY(6px) rotate(45deg);
	}
	.site-header__toggle[aria-expanded='true'] .site-header__bars::after {
		transform: translateY(-6px) rotate(-45deg);
	}

	/* Com JS: menu mobile fechado por padrão */
	:global(.js) .site-header__nav:not(.is-open) {
		display: none;
	}

	@media (min-width: 64rem) {
		.site-header__toggle {
			display: none;
		}
		.site-header__nav,
		:global(.js) .site-header__nav:not(.is-open) {
			display: flex;
			position: static;
			flex-direction: row;
			align-items: center;
			padding: 0;
			background: none;
			border: 0;
			gap: var(--space-xl);
		}
		.site-header__nav ul {
			flex-direction: row;
			gap: var(--space-lg);
		}
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
</style>

<script>
	const header = document.querySelector<HTMLElement>('[data-header]');
	const toggle = header?.querySelector<HTMLButtonElement>('[data-toggle]');
	const nav = header?.querySelector<HTMLElement>('[data-nav]');

	if (header && toggle && nav) {
		document.documentElement.classList.add('js');
		const set = (open: boolean) => {
			toggle.setAttribute('aria-expanded', String(open));
			nav.classList.toggle('is-open', open);
		};
		toggle.addEventListener('click', () =>
			set(toggle.getAttribute('aria-expanded') !== 'true'),
		);
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
				set(false);
				toggle.focus();
			}
		});
		nav.addEventListener('click', (e) => {
			if ((e.target as HTMLElement).closest('a')) set(false);
		});
	}
</script>
