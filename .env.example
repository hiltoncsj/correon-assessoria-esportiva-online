# Copie para .env e preencha. O .env NUNCA vai para o git.
APP_ENV=production            # local | production
APP_URL=https://seudominio.com.br
# SITE_URL=/            (só é preciso mudar se o site ficar em outro endereço)

DB_HOST=correon.mysql.dbaas.com.br
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# log = grava e-mails em backend/storage/mail (desenvolvimento) | mail = função mail() do PHP
MAIL_DRIVER=mail
MAIL_FROM=nao-responder@seudominio.com.br
MAIL_FROM_NAME=CorreON

# Tarefa agendada dos lembretes: gere uma chave aleatória com 32 caracteres ou mais
CRON_TOKEN=
